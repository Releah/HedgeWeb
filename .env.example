PORT=8080
PUBLIC_ORIGIN=https://ssh.example.com
DATA_DIR=./data
AUTH_MODE=both
COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Used only once, when no local users exist. Remove after first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Authentik forward-auth headers are accepted only from these direct peer IPs.
# Use the Traefik container IP or a fixed reverse-proxy address, never 0.0.0.0/0.
TRUSTED_PROXY_IPS=127.0.0.1,::1
AUTHENTIK_USER_HEADER=x-authentik-username
AUTHENTIK_EMAIL_HEADER=x-authentik-email
AUTHENTIK_GROUPS_HEADER=x-authentik-groups
AUTHENTIK_ADMIN_GROUP=HedgeWeb Admins

# Required in production. Generate with: openssl rand -base64 32
# Set this through your stack manager's secret/environment-variable UI.
# Never commit the generated value.
VPN_CONFIG_KEY=replace-with-a-base64-encoded-32-byte-random-value
